@startuml
!include ../_style.iuml
left to right direction
title Use cases — Phone app (realme, ARCore)

actor User as user
actor Developer as dev
actor "ARCore\n(pose, Depth API)" as arcore <<system>>
actor "Basir server\n(laptop)" as server <<system>>

rectangle "Phone app" {
  usecase "Connect to the server" as UC_connect
  usecase "Stream frames + pose + depth" as UC_stream
  usecase "Ask a question\n(type or speak)" as UC_ask
  usecase "Show answer, keyframe\nand directions" as UC_show
  usecase "Overlay the object mask" as UC_mask
  usecase "Record a session to files" as UC_record
  usecase "Reconnect automatically" as UC_reconnect
}

user --> UC_connect
user --> UC_ask
user --> UC_show
UC_record <-- dev

UC_connect ..> UC_stream : <<include>>
UC_reconnect .> UC_connect : <<extend>>\n[connection lost]
UC_show ..> UC_mask : <<include>>

UC_stream --> arcore
UC_record --> arcore
UC_stream --> server
UC_ask --> server
@enduml

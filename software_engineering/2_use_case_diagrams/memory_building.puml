@startuml
!include ../_style.iuml
left to right direction
title Use cases — Building the spatial memory

actor User as user
actor "ARCore" as arcore <<system>>
actor "Detector\n(YOLO-World / Grounding DINO)" as det <<system>>
actor "Segmenter\n(SAM 2 / SAM 3)" as sam <<system>>
actor "Embedder\n(SigLIP 2, DINOv2)" as emb <<system>>
actor "Captioner VLM\n(optional)" as vlm <<system>>

rectangle "Memory building" {
  usecase "Stream frames + pose" as UC_stream
  usecase "Select keyframes" as UC_key
  usecase "Detect objects" as UC_det
  usecase "Segment each detection" as UC_seg
  usecase "Embed each crop" as UC_emb
  usecase "Estimate depth" as UC_depth
  usecase "Back-project to a\n3D world position" as UC_3d
  usecase "Fuse into an object track" as UC_fuse
  usecase "Create a new track" as UC_new
  usecase "Caption the keyframe" as UC_cap
  usecase "Store keyframe + track" as UC_store
}

user --> UC_stream
UC_stream --> arcore

UC_stream ..> UC_key : <<include>>
UC_key ..> UC_det : <<include>>
UC_det ..> UC_seg : <<include>>
UC_seg ..> UC_emb : <<include>>
UC_key ..> UC_depth : <<include>>
UC_seg ..> UC_3d : <<include>>
UC_3d ..> UC_fuse : <<include>>
UC_new .> UC_fuse : <<extend>>\n[no match]
UC_cap .> UC_key : <<extend>>\n[captions on]
UC_fuse ..> UC_store : <<include>>

UC_det --> det
UC_seg --> sam
UC_emb --> emb
UC_depth --> arcore
UC_cap --> vlm
@enduml

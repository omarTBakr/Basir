@startuml
!include ../_style.iuml
left to right direction
title Use cases — Guidance and re-acquisition

actor User as user
actor "ARCore\n(live pose)" as arcore <<system>>
actor "Detector + SAM\n(query-time models)" as vision <<system>>

rectangle "Guidance" {
  usecase "Follow live guidance" as UC_guide
  usecase "Update directions\non every pose" as UC_update
  usecase "Check if the object\nshould be in view" as UC_frustum
  usecase "Search the region\nand segment" as UC_detect
  usecase "Confirm by embedding\nsimilarity" as UC_confirm
  usecase "Show \"Found it!\" + mask" as UC_found
  usecase "Keep tracking the mask" as UC_track
  usecase "Mark the track stale" as UC_stale
  usecase "Offer the next candidate" as UC_next
}

user --> UC_guide
UC_guide --> arcore

UC_guide ..> UC_update : <<include>>
UC_update ..> UC_frustum : <<include>>
UC_detect .> UC_frustum : <<extend>>\n[in view]
UC_detect ..> UC_confirm : <<include>>
UC_found .> UC_confirm : <<extend>>\n[match]
UC_found ..> UC_track : <<include>>
UC_stale .> UC_confirm : <<extend>>\n[not there]
UC_stale ..> UC_next : <<include>>

UC_detect --> vision
UC_track --> vision
@enduml

@startuml
!include ../_style.iuml
left to right direction
title Use cases — Basir (whole system)

actor User as user
actor Developer as dev
actor "Robot operator\n(later phase)" as robot
actor "ARCore\n(on the phone)" as arcore <<system>>
actor "Vision models\n(detector, SAM, SigLIP, depth)" as vision <<system>>
actor "LLM / VLM\n(Claude API or local)" as llm <<system>>
actor "Datasets\n(TUM RGB-D, recordings)" as data <<system>>

rectangle "Basir" {
  usecase "Stream the camera\nto the server" as UC_stream
  usecase "Build spatial memory\n(keyframes, objects, 3D)" as UC_memory
  usecase "Ask where an object is" as UC_ask
  usecase "Get directions from\nmy current pose" as UC_dir
  usecase "Follow live guidance" as UC_guide
  usecase "See the object segmented\nwhen back in view" as UC_seg
  usecase "Record a session" as UC_record
  usecase "Replay a dataset / recording" as UC_replay
  usecase "Run the evaluation" as UC_eval
  usecase "Tune configs and thresholds" as UC_config
  usecase "Send the robot to an object" as UC_robot
}

user --> UC_stream
user --> UC_ask
user --> UC_guide
user --> UC_seg

dev --> UC_record
dev --> UC_replay
dev --> UC_eval
dev --> UC_config
robot --> UC_robot

UC_stream --> arcore
UC_record --> arcore
UC_memory --> vision
UC_ask --> llm
UC_seg --> vision
UC_replay --> data
UC_eval --> data

UC_stream ..> UC_memory : <<include>>
UC_ask ..> UC_dir : <<include>>
UC_guide ..> UC_seg : <<include>>
@enduml

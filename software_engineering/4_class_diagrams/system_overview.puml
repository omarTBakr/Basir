@startuml
!include ../_style.iuml
title Whole system — packages and main classes

package "basir.api" {
  class Server
  class GradioUI
}
package "basir.pipeline" {
  class Pipeline
}
package "basir.ingest" {
  interface FrameSource
  class KeyframeSelector
}
package "basir.perception" {
  interface Detector
  interface Segmenter
  interface Embedder
  interface DepthProvider
  interface Captioner
}
package "basir.spatial" {
  interface LocalizationProvider
  class OccupancyMap
}
package "basir.memory" {
  class MemoryStore
  class Fusion
  class KeyframeStore
}
package "basir.query" {
  class QueryEngine
  class QueryParser
  class Retriever
  class Reranker
  class DirectionsPlanner
}
package "basir.guidance" {
  class GuidanceLoop
  class Reacquirer
  class Tracker
}
package "basir.core" {
  class Frame
  class Observation
  class ObjectTrack
  class Pose
  class geometry <<module>>
}

Server --> Pipeline
Server --> QueryEngine
Server --> GuidanceLoop
GradioUI ..> Server : uses
Pipeline --> FrameSource
Pipeline --> KeyframeSelector
Pipeline --> Detector
Pipeline --> Segmenter
Pipeline --> Embedder
Pipeline --> DepthProvider
Pipeline --> LocalizationProvider
Pipeline --> Fusion
Fusion --> MemoryStore
Pipeline --> KeyframeStore
QueryEngine --> QueryParser
QueryEngine --> Retriever
QueryEngine --> Reranker
QueryEngine --> DirectionsPlanner
Retriever --> MemoryStore
GuidanceLoop --> DirectionsPlanner
GuidanceLoop --> Reacquirer
GuidanceLoop --> Tracker
DirectionsPlanner ..> OccupancyMap : L3 (later)

note bottom of geometry
  Every package uses basir.core
  (types + geometry). Arrows to it
  are left out to keep the picture readable.
end note
@enduml

@startuml
!include ../_style.iuml
title Query and guidance — answering and guiding to the object

class QueryEngine {
  -parser: QueryParser
  -retriever: Retriever
  -reranker: Reranker
  -directions: DirectionsPlanner
  -localization: LocalizationProvider
  +ask(text): QueryResult
  -rank(candidates, verify_scores): list
}

class QueryParser {
  -llm: LLMClient
  +parse(text): ParsedQuery
}

class Retriever {
  -store: MemoryStore
  -embedder: Embedder
  +retrieve(query, k): list[(ObjectTrack, score)]
}

class Reranker {
  -vlm: LLMClient
  -keyframes: KeyframeStore
  +verify(query, tracks): list[float]
}

class DirectionsPlanner {
  +directions(position_world, pose): Directions
  -phrase(bearing, distance, height): str
}

abstract class LLMClient {
  +structured(prompt, schema): dict
  +look(prompt, images): str
}
class ClaudeClient
class LocalVLMClient {
  ' e.g. Qwen2.5-VL, if VRAM allows
}
LLMClient <|-- ClaudeClient
LLMClient <|-- LocalVLMClient

class GuidanceLoop {
  -target: ObjectTrack
  -directions: DirectionsPlanner
  -reacquirer: Reacquirer
  -tracker: Tracker
  -publish: Callable
  +start(track)
  +on_frame(frame)
  +stop()
}

class Reacquirer {
  -detector: Detector
  -segmenter: Segmenter
  -embedder: Embedder
  -tau_confirm: float
  +in_view(track, frame): (u, v) | None
  +search(frame, pixel, track): mask | None
}

class Tracker {
  -sam2: SAM2Segmenter
  +start(frame, mask)
  +update(frame): mask
}

class Server {
  ' the Console (basir.api, built: see api_console)
  +ws_stream(socket)   ' built
  +ws_query(socket)    ' Phase 1
  +get_keyframe(id)    ' Phase 1
}

QueryEngine --> QueryParser
QueryEngine --> Retriever
QueryEngine --> Reranker
QueryEngine --> DirectionsPlanner
QueryParser --> LLMClient
Reranker --> LLMClient
GuidanceLoop --> DirectionsPlanner
GuidanceLoop --> Reacquirer
GuidanceLoop --> Tracker
Server --> QueryEngine
Server --> GuidanceLoop
@enduml

@startuml
!include ../_style.iuml
title Ingest and localization — frame sources, keyframes, poses

interface FrameSource {
  +intrinsics: CameraIntrinsics
  +__iter__(): Iterator[Frame]
  +__len__(): int
  +close()
}
class TUMDatasetSource {
  -root: Path
  -stride: int
  -max_frames: int | None
  +intrinsics_source: str
  ' reads associations_with_gt.txt (download_dataset.py)
  ' intrinsics: intrinsics.json > freiburg1/2/3 calibration > Settings default
  +__getitem__(i): Frame
}
class RecordingSource {
  -session_dir: Path
  ' phone recordings (RGB + pose + depth + K)
}
class ARCoreStreamSource {
  -queue: asyncio.Queue
  +on_message(bytes)
  ' live frames from the phone WebSocket
}
class WebcamSource {
  -device: int
  ' no pose / depth: L1 only
}
class ROS2Source {
  ' later phase: /camera, /depth, /tf
}

FrameSource <|.. TUMDatasetSource
FrameSource <|.. RecordingSource
FrameSource <|.. ARCoreStreamSource
FrameSource <|.. WebcamSource
FrameSource <|.. ROS2Source

class KeyframeSelector {
  -min_interval_s: float
  -min_translation_m: float
  -min_rotation_deg: float
  -min_visual_change: float
  -last: Frame | None
  +is_keyframe(frame): bool
}

interface LocalizationProvider {
  +pose_at(t): Pose | None
  +latest(): Pose | None
}
class FramePoseProvider {
  ' pose already in the Frame:
  ' dataset ground truth or ARCore
}
class SLAMProvider {
  ' later / fallback: RTAB-Map, ORB-SLAM3
}
class ROS2TFProvider {
  ' later phase: robot odometry via /tf
}
LocalizationProvider <|.. FramePoseProvider
LocalizationProvider <|.. SLAMProvider
LocalizationProvider <|.. ROS2TFProvider

class OccupancyMap {
  ' L3 later: grid from SLAM for Nav2 paths
  +path(from_pose, to_point): list[ndarray]
}

KeyframeSelector ..> FrameSource : consumes frames
note bottom of ARCoreStreamSource
  Chosen deployment: realme phone with ARCore
  streams to the laptop server, so pose comes
  with every frame and no SLAM runs on the GPU.
end note
@enduml

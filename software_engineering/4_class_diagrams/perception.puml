@startuml
!include ../_style.iuml
title Perception — detector, segmenter, embedder, depth, captioner adapters

class Detection <<dataclass>> {
  +bbox: tuple[int, int, int, int]
  +label: str
  +score: float
}

abstract class Detector {
  +vocabulary: list[str]
  +detect(rgb, prompts): list[Detection]
}
class YOLOWorldDetector {
  ' always-on pass, fast
}
class GroundingDINODetector {
  ' query time / re-acquisition, accurate
}
class SAM3Detector {
  ' text-prompted detect + segment
}
Detector <|-- YOLOWorldDetector
Detector <|-- GroundingDINODetector
Detector <|-- SAM3Detector

abstract class Segmenter {
  +segment(rgb, boxes): list[mask]
}
class SAM2Segmenter {
  +init_video(frame, mask)
  +propagate(frame): mask
}
class EfficientSAMSegmenter
Segmenter <|-- SAM2Segmenter
Segmenter <|-- EfficientSAMSegmenter

abstract class Embedder {
  +dim: int
  +embed_images(crops): ndarray
  +embed_text(texts): ndarray
}
class SigLIP2Embedder {
  ' text <-> image retrieval
}
class DINOv2Embedder {
  ' image <-> image matching (fusion)
  +embed_text(): NotImplemented
}
Embedder <|-- SigLIP2Embedder
Embedder <|-- DINOv2Embedder

abstract class DepthProvider {
  +depth(frame): ndarray[HxW]
}
class FrameDepth {
  ' passthrough: ARCore Depth API,
  ' dataset or RGB-D sensor
}
class DepthAnythingMetric {
  ' fallback for frames without depth
}
DepthProvider <|-- FrameDepth
DepthProvider <|-- DepthAnythingMetric

abstract class Captioner {
  +caption(rgb): str
}
class VLMCaptioner {
  -client: LLMClient
}
Captioner <|-- VLMCaptioner

class ModelRegistry {
  -config: Config
  +detector(kind): Detector
  +segmenter(): Segmenter
  +embedder(kind): Embedder
  +depth(): DepthProvider
  +captioner(): Captioner | None
}
ModelRegistry ..> Detector : builds
ModelRegistry ..> Segmenter : builds
ModelRegistry ..> Embedder : builds
ModelRegistry ..> DepthProvider : builds
ModelRegistry ..> Captioner : builds
Detector ..> Detection : returns

note bottom of ModelRegistry
  8 GB VRAM budget: models load lazily in fp16;
  query-time models are loaded on demand.
end note
@enduml

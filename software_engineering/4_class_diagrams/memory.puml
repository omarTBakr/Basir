@startuml
!include ../_style.iuml
title Memory — fusion, vector store, keyframe store

class Fusion {
  -store: MemoryStore
  -tau_sim: float
  -tau_dist_m: float  ' ≈ 0.5
  +add(observation): ObjectTrack
  -match(observation): ObjectTrack | None
  +merge_duplicates()  ' periodic DBSCAN on position + embedding
}

class MemoryStore {
  -client: QdrantClient
  -collection: str
  +upsert_observation(obs)
  +upsert_track(track)
  +get_track(id): ObjectTrack
  +nearby_tracks(position, radius): list[ObjectTrack]
  +search(vector, filters, k): list[(ObjectTrack, score)]
  +keyword_search(text, filters, k): list[ObjectTrack]
  +mark_stale(track_id)
  +expire_observations(ttl_s)
}

class KeyframeStore {
  -root: Path
  +save(frame): str  ' JPEG path
  +load(frame_id): ndarray
  +crop(observation): ndarray
}

class SearchFilters <<dataclass>> {
  +since: float | None
  +until: float | None
  +labels: list[str] | None
  +include_stale: bool
}

Fusion --> MemoryStore
MemoryStore ..> SearchFilters
MemoryStore ..> ObjectTrack
MemoryStore ..> Observation
KeyframeStore ..> Observation : crop source

class ObjectTrack
class Observation

note right of MemoryStore
  Qdrant (local Docker) holds two collections:
  observations (raw, TTL) and tracks (fused).
  Payload = time, 3D position, label, frame ref.
  Data on the NVMe; keyframe JPEGs on disk.
end note
@enduml

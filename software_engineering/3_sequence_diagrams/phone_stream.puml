@startuml
!include ../_style.iuml
title Phone app — connect, stream and display
autonumber "<b>0"

actor User as user
participant "Phone app\n(Android)" as app
participant "ARCore session" as arcore
participant "WebSocket\n(Wi-Fi or USB tethering)" as ws
participant "FastAPI server" as api
participant "ARCoreStreamSource" as src

user -> app : open, enter server address
app -> arcore : start session (Depth API on)
app -> ws : connect
ws -> api : /ws/stream
api -> src : register stream
api --> app : hello{session_id, wanted fps / resolution}

loop each ARCore frame
  arcore --> app : camera image, pose (6-DoF), depth, intrinsics, timestamp
  alt tracking state = TRACKING
    app -> ws : binary: JPEG + depth (16-bit) + JSON{pose, K, t}
    ws -> api
    api -> src : decode → Frame
  else tracking lost
    app -> ws : status{tracking: lost}
    note right of app
      Frames without a good pose are not used
      for 3D memory; the user sees a hint to
      move the phone slowly.
    end note
  end
end

user -> app : ask a question
app -> ws : JSON{type: query, text}
ws -> api
api --> app : JSON{type: answer, text, keyframe_url, directions}
api --> app : JSON{type: directions, ...} (repeated)
api --> app : JSON{type: mask, rle, frame_t}
app -> app : draw mask overlay on the live view

opt connection lost
  app -> ws : reconnect with backoff, same session_id
end
@enduml

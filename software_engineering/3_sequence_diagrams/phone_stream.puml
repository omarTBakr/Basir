@startuml
!include ../_style.iuml
title Phone page — connect, stream and display (as built; a native app comes later)
autonumber "<b>0"

actor User as user
participant "Phone page\n(Chrome on the phone)" as page
participant "WebXR session\n(immersive-ar: camera-access, depth-sensing)" as xr
participant "Phone listener\n(https://<LAN IP>:8001)" as listener
participant "Console\n(127.0.0.1:8000)" as console

user -> page : open the QR-code URL from the Devices tab
page -> listener : GET / (phone page); pair once (see phone_pairing)
listener --> page : token "bsr_…" kept in localStorage

user -> page : **Start AR stream** (or **Start camera stream**: colour only, any browser)
page -> xr : requestSession("immersive-ar", depth-sensing, camera-access)
page -> listener : WebSocket wss://…/ws/stream/{device_id}
page -> listener : {"type": "auth", "token": "bsr_…"} (first message)
listener --> page : accepted (1008 if wrong, expired or missing)

loop each XR frame (≈ 5 fps with depth, ≈ 10 fps colour only)
  xr --> page : camera image, viewer pose (6-DoF), depth (160 columns), projection matrix
  alt tracking
    page -> page : WebXR camera (y up, −z forward) → Basir camera (y down, z forward)\nintrinsics from the projection matrix, depth in mm
    page -> listener : binary: u32 length | JSON{seq, t, intrinsics, pose, depth{w, h, scale}} | JPEG | depth16
    listener -> console : QueuedFrame → bus, live view, live map (see async_ingest)
    console --> listener : FrameResult
    listener --> page : JSON{seq, latency_ms, queue_ms, batch_size, dropped}
    page --> user : fps, latency, dropped
  else tracking lost / no pose
    page -> listener : frame without pose (colour only)
    note right of page
      Frames without a pose feed the Live view
      and the GPU batch but not the 3D map.
    end note
  end
end

user -> console : Live tab: colour + depth of this phone\n3D map tab: the fused voxel map
console -> listener : /ws/view/{device_id}, /ws/map/{device_id}
listener --> console : JPEG + depth PNG at VIEW_MAX_FPS, points

user -> page : Stop
page -> listener : close
listener -> console : disconnect: registry, bus, map session (idle TTL)

note over page, listener
  Later (Phase 1+): the same socket carries
  {"type": "query", text} and the answers back
  (see system_overview and query_where_is).
  The planned native ARCore app speaks this
  same protocol and pairing.
end note
@enduml

@startuml
!include ../_style.iuml
title Ingest — from a frame to object tracks in memory
autonumber "<b>0"

participant "FrameSource\n(phone / replay)" as src
participant "KeyframeSelector" as ks
queue "Keyframe queue\n(bounded)" as kq
participant "Detector\n(YOLO-World, ~200 nouns)" as det
participant "Segmenter\n(SAM 2 box prompt)" as sam
participant "Embedder\n(SigLIP 2)" as emb
participant "DepthProvider\n(ARCore / sensor / model)" as depth
participant "geometry" as geo
participant "Fusion" as fuse
database "MemoryStore\n(Qdrant)" as store
database "KeyframeStore\n(JPEG on disk)" as kfs

src -> ks : Frame{rgb, depth?, K, pose, t}
alt time, motion or view change above threshold
  ks -> kq : put(frame)
  note right of kq
    Ingest never blocks: when the queue is full
    the oldest keyframe is dropped.
  end note
else
  ks -> ks : skip
end

kq -> det : frame.rgb
det --> kq : boxes, labels, scores
kq -> sam : rgb + boxes
sam --> kq : masks
kq -> emb : masked crops (batched)
emb --> kq : crop embeddings
kq -> depth : depth for frame
depth --> kq : depth map (m)
loop each detection
  kq -> geo : backproject(median depth in mask, centroid, K)
  geo -> geo : p_world = T_world_cam · p_cam
  geo --> kq : position_world
  kq -> fuse : Observation
  fuse -> store : nearby tracks (distance < τ_dist, compatible label)
  alt cosine > τ_sim
    fuse -> store : update track (running embedding, position, last_seen)
  else no match
    fuse -> store : create new ObjectTrack
  end
end
kq -> kfs : save keyframe JPEG (frame ref in observations)
@enduml

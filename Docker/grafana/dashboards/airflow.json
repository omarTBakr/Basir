            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum by (dag_id, state) (rate(airflow_dagrun_duration_seconds_sum[1h])) / sum by (dag_id, state) (rate(airflow_dagrun_duration_seconds_count[1h]))",
          "legendFormat": "{{dag_id}} {{state}}",

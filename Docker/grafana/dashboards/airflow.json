    {
      "id": 4,
      "type": "stat",
      "title": "DAG import errors",
      "description": "dags/ files that failed to parse; see the Airflow UI for the traceback.",
      "datasource": {
        "type": "prometheus",
        "uid": "basir-prometheus"
      },
      "gridPos": {
        "x": 18,

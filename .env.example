# ==============================================================================
# Basir - Spatial Memory & Guidance System Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Application & Environment
APP_NAME=Basir
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Compute Hardware (auto, cuda, cpu, mps)
DEVICE=auto

# Server & UI Networking
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
WS_PATH=/ws/stream

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_KEYFRAMES=basir_keyframes
QDRANT_COLLECTION_OBJECTS=basir_objects

# Perception & AI Models
DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
SEGMENTER_MODEL=facebook/sam2-hiera-tiny
EMBEDDER_MODEL=google/siglip-base-patch16-224
DINO_MODEL=facebook/dinov2-base
DEPTH_MODEL=depth-anything/Depth-Anything-V2-metric-indoor-small
VLM_MODEL=microsoft/Florence-2-base

# External LLM / VLM API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Custom Storage & Data Root Override (leave blank for default project root)
DATA_DIR=

# Logging
LOG_FILE_PATH=

# Observability: Langfuse (runtime traces of queries) and MLflow (evaluation runs)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Default: sqlite:///<DATA_DIR or project>/mlflow.db
MLFLOW_TRACKING_URI=

# Any variable above can also be set as BASIR_<NAME> in the environment;
# the prefixed form wins (e.g. BASIR_DEBUG=False overrides DEBUG).


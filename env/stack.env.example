# Basir local stack settings, read by Docker/docker-compose.yml through scripts/stack.sh.
# `scripts/stack.sh up` copies this file to env/stack.env (git-ignored) and fills in
# random passwords the first time; edit env/stack.env, never this example.

# Postgres superuser shared by MLflow and Airflow (databases mlflow, airflow)
POSTGRES_USER=basir
POSTGRES_PASSWORD=change-me

# Host port for Postgres (5432 is often taken by a system Postgres)
POSTGRES_PORT=5433

# Grafana admin login (anonymous visitors get the Viewer role)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Host folder for MLflow artifacts. Blank = <project>/mlartifacts; scripts/stack.sh
# resolves relative paths from the project root.
MLFLOW_ARTIFACTS_DIR=

# Airflow (UI and REST API on 127.0.0.1:8080, user `admin`). Blank values are generated by
# scripts/stack.sh: the admin password, the Fernet key that encrypts connections in the
# metadata database, the JWT secret shared by Airflow's components, the API server's secret key.
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

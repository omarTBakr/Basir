# Basir configuration. Copy to env/.env and adjust:
#   cp env/.env.example env/.env
# Every key can also be set as BASIR_<NAME> in the environment; the prefixed form wins.
# Later phases add their own settings here when they are built.

# development, staging or production (also tags Langfuse traces)
APP_ENV=development

# Compute device: auto, cuda, cpu or mps
DEVICE=auto

# Root for datasets/, outputs/, mlflow.db and mlartifacts/ (blank = the project folder)
DATA_DIR=

# MLflow: blank = sqlite:///<DATA_DIR or project>/mlflow.db
# With the local stack running (scripts/stack.sh up): http://127.0.0.1:5000
MLFLOW_TRACKING_URI=

# Prometheus of the local stack
PROMETHEUS_URL=http://127.0.0.1:9090

# Temporal frontend (host:port) that pipeline workers and run_pipeline.py connect to
TEMPORAL_ADDRESS=127.0.0.1:7233

# Langfuse: tracing stays off until both keys are set (blank URL = Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Server and UI (scripts/serve.py): Grafana for the Dashboards page, Temporal UI for links
GRAFANA_URL=http://127.0.0.1:3000
TEMPORAL_UI_URL=http://127.0.0.1:8233

# Live ingest: frames kept per phone (older ones are dropped), GPU micro-batch size and wait
INGEST_QUEUE_SIZE=2
BATCH_MAX_SIZE=8
BATCH_MAX_WAIT_MS=20

# Console: phone-only listener on the LAN (the Console itself stays on 127.0.0.1:8000),
# loopback ports for the framed MLflow / Temporal UIs, Live view frame rate
INGEST_HOST=0.0.0.0
INGEST_PORT=8001
INGEST_TLS=true
MLFLOW_EMBED_PORT=8002
TEMPORAL_EMBED_PORT=8003
VIEW_MAX_FPS=15

# Live map: voxel size, keyframe gate (move or turn), most voxels per map
MAP_VOXEL_M=0.02
MAP_KEYFRAME_M=0.05
MAP_KEYFRAME_DEG=5
MAP_MAX_POINTS=2000000

# Live map lifetime: free a map after this many seconds without frames or viewers; most maps kept
MAP_IDLE_TTL_S=600
MAP_MAX_SESSIONS=8

# Largest image width/height a phone may send; seconds to wait for the GPU worker to load
INGEST_MAX_IMAGE_SIDE=4096
WORKER_STARTUP_TIMEOUT_S=120

# Days a paired phone's token stays valid (then pair again from the Devices tab)
TOKEN_TTL_DAYS=30

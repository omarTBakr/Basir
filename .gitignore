# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
# env/ holds the settings (.env) and the stack passwords (stack.env); only the *.example files are committed
/env/.env
/env/stack.env
.env

# Data, models and runtime output (kept on disk, never committed)
# datasets/<sequence>/ folders stay out of git; DVC versions them (datasets/*.dvc are committed)
/datasets/?*/
_archives/
weights/
logs/
qdrant_storage/
mlruns/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Experiment tracking and generated output
mlflow.db
mlartifacts/
outputs/


# Private planning documents (kept locally, not published)
PLAN.md
STUDY.md

# Claude Code: project skills, agent worktrees and local settings (kept locally)
.claude/

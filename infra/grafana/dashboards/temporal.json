        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(increase(workflow_success[1h])) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workflows failed (1h)",
      "description": "Failed plus timed-out workflow executions.",
      "datasource": {
        "type": "prometheus",
        "uid": "basir-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "(sum(increase(workflow_failed[1h])) or vector(0)) + (sum(increase(workflow_timeout[1h])) or vector(0))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Frontend errors/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "basir-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(service_error_with_type{service_name=\"frontend\"}[1m])) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Workflow outcomes",
      "description": "Workflow executions closed per minute, by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "basir-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(workflow_success[5m])) * 60",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(workflow_failed[5m])) * 60",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(workflow_timeout[5m])) * 60",
          "legendFormat": "timed out",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(workflow_terminate[5m])) * 60",
          "legendFormat": "terminated",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum(rate(workflow_cancel[5m])) * 60",
          "legendFormat": "cancelled",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Activity task calls",
      "description": "Worker calls that report activity results: a proxy for activity throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "basir-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "basir-prometheus"
          },
          "expr": "sum by (operation) (rate(service_requests{operation=~\"RespondActivityTask.*|RecordActivityTaskHeartbeat.*\"}[1m]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",

# Basir local stack settings, read by docker-compose.yml through scripts/stack.sh.
# `scripts/stack.sh up` copies this file to infra/stack.env (git-ignored) and fills in
# random passwords the first time; edit infra/stack.env, never this example.

# Postgres superuser shared by MLflow and Temporal
POSTGRES_USER=basir
POSTGRES_PASSWORD=change-me

# Host port for Postgres (5432 is often taken by a system Postgres)
POSTGRES_PORT=5433

# Grafana admin login (anonymous visitors get the Viewer role)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Host folder for MLflow artifacts (relative paths start at the project root)
MLFLOW_ARTIFACTS_DIR=./mlartifacts
